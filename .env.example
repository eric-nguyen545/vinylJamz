# Public Firebase client config (not secrets; Firestore rules enforce security)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Owner's Firebase Auth UID (UI gate only; firestore.rules is the real enforcement)
VITE_OWNER_UID=
# Repo name for GitHub Pages, e.g. /vinyl-archive/  (use / for local dev or a custom domain)
VITE_APP_BASE_PATH=/
VITE_PUBLIC_APP_URL=
# Set to true to use the local Firebase emulators
VITE_USE_EMULATORS=false
# Optional: add a Content Security Policy to the production build. Test with `npm run build && npm run preview`
# and check the browser console for blocked requests before turning this on for the deployed site.
VITE_ENABLE_CSP=false
